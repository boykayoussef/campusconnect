# Supabase PostgreSQL connection string (keep the real value in backend/.env only)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Admin seed (never commit backend/.env)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@campusconnect.local
ADMIN_PASSWORD=replace-with-an-8-character-or-longer-password

# Optional AI event categorization
HUGGINGFACE_API_KEY=
